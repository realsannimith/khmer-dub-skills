# Copy to config.env (same folder) to use Python environments or models you already have,
# instead of the ones setup.sh makes inside the skill. Every line is optional.
# config.env is machine-specific and is not committed.

# Python with edge-tts, numpy, soundfile and Pillow (Pillow with Raqm, for Khmer text).
# KHMER_DUB_TTS_PYTHON=/path/to/venv/bin/python

# Python with torch, demucs, librosa, soundfile and transformers.
# Set it and setup.sh --ai does nothing.
# KHMER_DUB_AI_PYTHON=/path/to/venv/bin/python

# Python with mlx-whisper (Apple Silicon). Set it and setup.sh --mlx does nothing.
# KHMER_DUB_MLX_PYTHON=/path/to/venv/bin/python

# Extra folders (':'-separated) to find Demucs in, when it is installed outside that Python.
# KHMER_DUB_EXTRA_SITE=/path/to/site-packages

# Where Demucs keeps its model (default: torch's own cache, ~/.cache/torch).
# TORCH_HOME=/path/to/demucs/models

# 1 = never download a model (use only what is already in the Hugging Face / torch cache).
# HF_HUB_OFFLINE=1

# Khmer font for covered subtitles (default: SKILL_DIR/fonts/KantumruyPro.ttf from setup.sh).
# KHMER_DUB_FONT=/path/to/KantumruyPro.ttf
